# AgentGuard backend configuration.
# Copy to `.env` and adjust. All values are safe local-development defaults.

# Database. Defaults to a local SQLite file so the stack runs with zero setup.
# For PostgreSQL use: postgresql+psycopg2://agentguard:agentguard@localhost:5432/agentguard
AGENTGUARD_DATABASE_URL=sqlite:///./agentguard.db

# Bind address for uvicorn (set by docker-compose / scripts, not required locally).
AGENTGUARD_HOST=127.0.0.1
AGENTGUARD_PORT=8000

# Demo authentication. Leave false for local development so the dashboard works
# without a login screen. Set true in deployed environments and front it with a
# real OIDC provider.
AGENTGUARD_AUTH_REQUIRED=false
AGENTGUARD_AUTH_SECRET=change-me-in-production

# Comma-separated list of browser origins allowed to call the API.
AGENTGUARD_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Governance defaults.
AGENTGUARD_APPROVAL_TTL_MINUTES=240
AGENTGUARD_RETENTION_DAYS=90
AGENTGUARD_MAX_PAYLOAD_BYTES=65536
AGENTGUARD_REDACT_SECRETS=true

# Seed the demo workspace (users, tools, agents, policies, approvals, events).
AGENTGUARD_SEED_DEMO_DATA=true
