# AgentGuard dashboard nginx configuration (template).
#
# Serves the built SPA and proxies `/api` to the backend service. The SPA's
# client-side router needs a fallback to index.html for deep links.
#
# ${BACKEND_HOST} is substituted by nginx's docker-entrypoint (20-envsubst-on-templates.sh)
# from the container environment at startup. The upstream is then resolved at
# request time via Docker's embedded DNS, so the container starts even if the
# backend is not yet reachable.

server {
    listen       8080;
    server_name  _;

    root   /usr/share/nginx/html;
    index  index.html;

    # Docker's embedded DNS resolves service names on the compose network.
    resolver 127.0.0.11 valid=30s ipv6=off;
    set $backend_upstream "${BACKEND_HOST}:8000";

    # Gzip static assets.
    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    # Reverse-proxy API calls to the backend service.
    location /api/ {
        proxy_pass http://$backend_upstream;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
    }

    # SPA fallback: unknown paths return index.html so React Router can handle them.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Never cache the HTML entry point; assets are content-hashed by Vite.
    location = /index.html {
        add_header Cache-Control "no-cache, no-store, must-revalidate";
    }
}
